{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".venv/bin/python -m pytest -q --tb=short >&2; rc=$?; if [ $rc -eq 5 ]; then exit 0; fi; if [ $rc -ne 0 ]; then exit 2; fi",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/log_prompt.py\""
          }
        ]
      }
    ]
  }
}